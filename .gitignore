yarn-debug.log*
yarn-error.log*

# CDK generated assemblies and staging
cdk.out/
.cdk.staging/

# Python environments, bytecode and tool caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
