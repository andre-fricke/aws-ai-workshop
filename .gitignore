# Local credentials and secrets; sanitized examples remain versionable
.env
.env.*
!.env.example
!.env.sample
.aws/
.secrets/
secrets.local.*
*.local.json

# Temporary run data and operating-system files
/tmp/
/temp/
/runs/
/artifacts/
*.log
.DS_Store

# Terraform local providers, state, sensitive variable files and saved plans
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
crash.*.log
# .terraform.lock.hcl and sanitized *.tfvars.example stay versionable.
